// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "cmd-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
      "cmd-p": "file_finder::Toggle",
      "space \\ a": "tab_switcher::Toggle",
      "ctrl-x n": "editor::GoToDiagnostic",
      "ctrl-x p": "editor::GoToPreviousDiagnostic",
      "shift-k": "editor::OpenDocs",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w a": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
      "ctrl-n": "agent::CycleNextInlineAssist",
      "ctrl-p": "agent::CyclePreviousInlineAssist",
    },
  },
]
